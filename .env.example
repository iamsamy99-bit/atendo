# Copia este archivo como .env.local y rellena con tus claves reales.
# .env.local está en .gitignore — nunca se sube al repositorio.

# ElevenLabs Conversational AI (widget web — legacy, actualmente sin uso)
VITE_ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id_here

# Vapi (agente de voz telefónico — Sofía)
# Dashboard: app.vapi.ai → Organization → API Keys
VAPI_PRIVATE_KEY=your_vapi_private_key_here
VAPI_PUBLIC_KEY=your_vapi_public_key_here
VAPI_ASSISTANT_ID=f861274a-c871-4ac5-8f5c-d3d5cb97c947
VAPI_PHONE_NUMBER=+16692680598

# Telnyx (para tramitar número mexicano y conectarlo a Vapi)
# Dashboard: portal.telnyx.com → API Keys
TELNYX_API_KEY=your_telnyx_api_key_here

# Make.com (webhook que recibe los leads de Vapi)
MAKE_LEADS_WEBHOOK=https://hook.us2.make.com/your_webhook_id_here

# Crisp
CRISP_WEBSITE_ID=your_crisp_website_id_here
