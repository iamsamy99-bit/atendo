{
  "mcp": {
    "allowed": ["atendo-project"]
  },
  "mcpServers": {
    "atendo-project": {
      "command": "node",
      "args": ["mcp/server.mjs"],
      "cwd": ".",
      "timeout": 180000,
      "trust": false,
      "includeTools": [
        "project_overview",
        "list_project_files",
        "read_project_file",
        "search_project",
        "git_diff",
        "run_validation"
      ]
    }
  }
}
